# Copy this file to secrets.yml (already gitignored by the repo's own
# *secret*.yml pattern -- verify with `git check-ignore -v secrets.yml`
# before committing anything, just in case) and fill in real values, then
# pass it to kcli:
#
#   sudo kcli create plan -f kcli-plan.yml --paramfile secrets.yml ...
#
# Uppercase parameter names are kcli's own convention for values that (also)
# need to become environment variables inside the target VM -- see the kcli
# docs' "Overriding parameters" section. Here they also get substituted
# directly into vm-router-init.sh's rendered content at plan-creation time.
#
# GCP_VPN_IP is the Cloud VPN gateway's external IP (created by
# ../../gcp/setup-cloudvpn.sh; not secret by itself, but grouped here since
# it belongs with SHARED_SECRET for a working VPN config).
SHARED_SECRET: ""
GCP_VPN_IP: ""
