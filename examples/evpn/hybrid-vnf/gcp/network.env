# Network configuration for the hybrid on-prem VNF <-> GCP EVPN VLAN stretch.
#
# Sourced by the GCP setup scripts and, on the on-prem side, by the VNF
# deploy.sh to render the IPsec parameters. Fill in the VPN values for your
# run; the rest match the PoC addressing and the ellorent-vlan-evpn cluster.
#
# Topology: OpenPERouter runs on every OpenShift node. The 3 control-plane
# nodes are pure BGP route reflectors (RFC 4456): no tunnelEndpoint, no VNIs,
# just a real address on an ipvlan interface and a routeReflector block. The
# worker nodes are the EVPN data-plane: each gets a VTEP derived from
# GCP_VTEP_CIDR and peers, statically, every control-plane RR. The on-prem VNF
# also peers every RR over the Cloud VPN, so its control-plane traffic uses
# GCP_RR_CIDR while the VXLAN data plane talks directly to the worker VTEPs in
# GCP_VTEP_CIDR (route reflection changes the BGP next-hop only for
# ipv4-unicast, not for l2vpn evpn, so VXLAN never transits the reflectors).

########################################
# 1. Cluster / project (GCP side)
########################################
# GCP project hosting the OpenShift cluster.
export GCP_PROJECT_ID="ocpstrat-1278"
export GCP_REGION="us-central1"
# Cluster infra ID (from `oc get infrastructure cluster
# -o jsonpath={.status.infrastructureName}`); env.sh discovers it if unset.
export CLUSTER_INFRA_ID="${CLUSTER_INFRA_ID:-}"

########################################
# 2. VTEP / route-reflector address pools
########################################
# GCP worker VTEPs. Derived per node from this pool and the node index, placed
# on the ipvlan underlay interface, and registered as instance alias IPs.
# Inside the worker subnet (10.0.128.0/17) and otherwise unused.
export GCP_VTEP_CIDR="10.0.200.0/24"
# Real addresses of the 3 control-plane route reflectors. Like GCP_VTEP_CIDR,
# each master derives its own address from this pool and its node index via
# tunnelEndpoint.interfaceName -- a route reflector has no VNIs, but that
# mechanism only requires a CNIDevice to place a derived address on, not a
# VNI. Inside the master subnet (10.0.0.0/17), clear of the primary node IPs
# (10.0.0.4-10.0.0.6), and otherwise unused.
export GCP_RR_CIDR="10.0.1.0/24"
# On-prem VNF VTEP pool (advertised into the VPN, node index 0 -> 100.65.0.0).
export VNF_VTEP_CIDR="100.65.0.0/24"

########################################
# 3. BGP
########################################
# Shared ASN of every GCP node (route reflectors and workers alike -- a single
# AS with route reflection needs no distinct per-role ASN).
export GCP_ASN="65001"
# On-prem VNF ASN.
export VNF_ASN="64514"
# BGP cluster-id shared by all 3 GCP route reflectors (RFC 4456 Sec.7), so
# CLUSTER_LIST loop detection works across them.
export GCP_RR_CLUSTER_ID="192.0.2.1"

########################################
# 4. Cloud VPN (fill these in)
########################################
# GCP Cloud VPN gateway external IP (created by setup-cloudvpn.sh; also printed
# there). Set on the on-prem side so the VNF knows the remote peer.
export GCP_VPN_IP="${GCP_VPN_IP:-}"
# This laptop's public IP (on-prem VPN endpoint). Autodetected if empty.
export ONPREM_PUBLIC_IP="${ONPREM_PUBLIC_IP:-}"
# IPsec pre-shared key shared by both ends.
export SHARED_SECRET="${SHARED_SECRET:-}"

########################################
# 5. Stretched L2VNI
########################################
export L2VNI="110"
# L2 subnet used by the workloads on the stretched segment (no gateway; pure
# east-west). Assign addresses from here on both the GCP pod and the on-prem
# VLAN host.
export L2_SUBNET="192.168.100.0/24"
